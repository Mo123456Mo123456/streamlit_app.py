# ═══════════════════════════════════════════════════════════════
# ⚙️ إعدادات وكيل الذكاء الاصطناعي
# انسخ هذا الملف إلى .env وأضف مفاتيحك
# ═══════════════════════════════════════════════════════════════

# مزود خدمة AI (local, openai, anthropic)
AI_PROVIDER=local

# مفتاح OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# مفتاح Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# اسم النموذج
AI_MODEL=gpt-4o-mini

# درجة الإبداعية (0.0 - 1.0)
AI_TEMPERATURE=0.7

# الحد الأقصى للرموز
AI_MAX_TOKENS=2000
