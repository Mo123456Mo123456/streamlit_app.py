# Silver — environment configuration (copy to .env and fill in)

# Admin bootstrap (created on first run only) — CHANGE THE PASSWORD
SILVER_ADMIN_USERNAME=admin
SILVER_ADMIN_EMAIL=admin@silver.local
SILVER_ADMIN_PASSWORD=ChangeMe_123

# API token signing secret — set a long random value in production
SILVER_JWT_SECRET=change-me-to-a-long-random-string

# Data directory (database + uploaded media)
# SILVER_DATA_DIR=/data

# LiveKit (real audio/video for live streams) — optional
# Create a project at https://cloud.livekit.io (or self-host) and fill these:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=secretxxxxxxxx
